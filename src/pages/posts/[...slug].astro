---
import { getCollection, render } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// 関連記事: 同カテゴリ優先 + タグの重なりでスコアリング(内部リンク強化)
const all = await getCollection("posts", ({ data }) => !data.draft);
const myTags = new Set(post.data.tags);
const related = all
  .filter((p) => p.id !== post.id && !p.data.noindex)
  .map((p) => ({
    p,
    score:
      (p.data.category === post.data.category ? 2 : 0) +
      p.data.tags.filter((t) => myTags.has(t)).length * 3,
  }))
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score || b.p.data.pubDate.valueOf() - a.p.data.pubDate.valueOf())
  .slice(0, 4)
  .map(({ p }) => ({ id: p.id, title: p.data.title, emoji: p.data.heroEmoji }));
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  category={post.data.category}
  tags={post.data.tags}
  heroEmoji={post.data.heroEmoji}
  aiGenerated={post.data.aiGenerated}
  related={related}
  noindex={post.data.noindex}
>
  <Content />
</PostLayout>
